                                <td>
                                    <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX')}">
                                        <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['tb_natrax_spacer_thickness'], jsonData['wb_natrax_spacer_thickness'])}"/>
                                    </apex:outputPanel>
                                    
                                    <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL')}">
                                        <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'SSSB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSSB_spacerThickness_input'], jsonData['w_SSSB_w_beam_spacerThickness_input']), 
                                                                  IF(CONTAINS(UPPER(row['name']), 'SSDB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSDB_spacerThickness_input'], jsonData['w_SSDB_w_beam_spacerThickness_input']),
                                                                  IF(CONTAINS(UPPER(row['name']), 'DSSB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_DSSB_spacerThickness_input'], jsonData['w_DSSB_w_beam_spacerThickness_input']),
                                                                  IF(CONTAINS(UPPER(row['name']), 'DSDB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_DSDB_spacerThickness_input'], jsonData['w_DSDB_w_beam_spacerThickness_input']), ''))))}"/>
                                    </apex:outputPanel>
                                </td>

                                <td>
                                    <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX') && NOT(CONTAINS(UPPER(row['name']), 'THRIE'))}">
                                        <apex:outputText value="{0, number, 0.00}">
                                            <apex:param value="{!VALUE(jsonData['wb_natrax_spacer_thickness']) + ((IF(CONTAINS(jsonData['wb_natrax_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['wb_natrax_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['wb_natrax_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" />
                                        </apex:outputText>
                                    </apex:outputPanel>
                                    <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX') && CONTAINS(UPPER(row['name']), 'THRIE')}">
                                        <apex:outputText value="{0, number, 0.00}">
                                            <apex:param value="{!VALUE(jsonData['tb_natrax_spacer_thickness']) + ((IF(CONTAINS(jsonData['tb_natrax_zinc_coating'], 'Regular'), 40, IF(CONTAINS(jsonData['tb_natrax_zinc_coating'], 'Average'), 65, IF(CONTAINS(jsonData['tb_natrax_zinc_coating'], 'Minimum'), 77, 0))) / 1000) * 2)}" />
                                        </apex:outputText>
                                    </apex:outputPanel>

                                    <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CONVENTIONAL')}">
                                        <apex:outputText value="{0, number, 0.00}">
                                            <apex:param value="{!VALUE(IF(CONTAINS(UPPER(row['name']), 'SSSB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSSB_spacerThickness_input'], jsonData['w_SSSB_w_beam_spacerThickness_input']), 
                                                                      IF(CONTAINS(UPPER(row['name']), 'SSDB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_SSDB_spacerThickness_input'], jsonData['w_SSDB_w_beam_spacerThickness_input']),
                                                                      IF(CONTAINS(UPPER(row['name']), 'DSSB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_DSSB_spacerThickness_input'], jsonData['w_DSSB_w_beam_spacerThickness_input']),
                                                                      IF(CONTAINS(UPPER(row['name']), 'DSDB'), IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['Thrie_DSDB_spacerThickness_input'], jsonData['w_DSDB_w_beam_spacerThickness_input']), ''))))) 
                                                                      + ((IF(CONTAINS(IF(CONTAINS(UPPER(row['name']), 'SSSB'), jsonData['w_SSSB_w_beam_zincCoating_input'], IF(CONTAINS(UPPER(row['name']), 'SSDB'), jsonData['w_SSDB_w_beam_zincCoating_input'], IF(CONTAINS(UPPER(row['name']), 'DSSB'), jsonData['w_DSSB_w_beam_zincCoating_input'], jsonData['w_DSDB_w_beam_zincCoating_input']))), 'Regular'), 40, IF(CONTAINS(IF(CONTAINS(UPPER(row['name']), 'SSSB'), jsonData['w_SSSB_w_beam_zincCoating_input'], IF(CONTAINS(UPPER(row['name']), 'SSDB'), jsonData['w_SSDB_w_beam_zincCoating_input'], IF(CONTAINS(UPPER(row['name']), 'DSSB'), jsonData['w_DSSB_w_beam_zincCoating_input'], jsonData['w_DSDB_w_beam_zincCoating_input']))), 'Average'), 65, IF(CONTAINS(IF(CONTAINS(UPPER(row['name']), 'SSSB'), jsonData['w_SSSB_w_beam_zincCoating_input'], IF(CONTAINS(UPPER(row['name']), 'SSDB'), jsonData['w_SSDB_w_beam_zincCoating_input'], IF(CONTAINS(UPPER(row['name']), 'DSSB'), jsonData['w_DSSB_w_beam_zincCoating_input'], jsonData['w_DSDB_w_beam_zincCoating_input']))), 'Minimum'), 77, 0))) / 1000) * 2)}" />
                                        </apex:outputText>
                                    </apex:outputPanel>
                                </td>
                            </tr>
                        </apex:outputPanel>

                    </tbody>
                </table>
            </apex:outputPanel>
            
        </apex:repeat>
    </body>
</apex:page>