<apex:page standardController="Quote" extensions="QuoteExportController" renderAs="pdf" applyHtmlTag="false" showHeader="false" standardStylesheets="false">
    <head>
        <style type="text/css">
            @page {
                size: A4;
                /* Create physical space at the top and bottom of every page for the header/footer */
                margin-top: 40mm;    
                margin-bottom: 35mm; 
                margin-left: 15mm;
                margin-right: 15mm;
                
                /* This injects the running elements into the page margins */
                @top-center {
                    content: element(header);
                }
                @bottom-center {
                    content: element(footer);
                }
            }
            
            body {
                font-family: sans-serif;
                font-size: 11px;
                color: #333;
            }
            
            /* ── Assign the header and footer to the running elements ── */
            .pdf-header {
                position: running(header);
            }
            
            .pdf-footer {
                position: running(footer);
                text-align: right;
                font-size: 8px;
                line-height: 1.3;
                color: #333;
            }

            /* ── Specifications Table Styling ── */
            .spec-table {
                width: 100%;
                border-collapse: collapse;
                border: 1px solid #000;
                margin-top: 5px;
                margin-bottom: 20px;
            }
            .spec-table th, .spec-table td {
                border: 1px solid #000;
                padding: 6px;
                text-align: center;
            }
            .spec-table th {
                background-color: #f2f2f2;
                font-weight: bold;
                font-size: 10px;
            }
            .spec-table td {
                font-size: 10px;
            }
            .table-title {
                font-weight: bold;
                font-size: 11px;
                margin-top: 15px;
                text-align: left;
            }
        </style>
    </head>
    <body>
        
        <div class="pdf-header">
            <table style="width: 100%; border-collapse: collapse; margin-bottom: 0; font-family: sans-serif; margin-top: 10mm;">
                <tr>
                    <td style="width: 100%; text-align: right; vertical-align: bottom; padding-bottom: 5px;">
                        <img src="{!$Resource.UtkarshHeader}" alt="Utkarsh header" style="width: 100%; height: auto;"/>
                    </td>
                </tr>
            </table>
        </div>

        <div class="pdf-footer">
            <div style="font-weight: bold;">Works:</div>
            <div>F1: Nh6. Vill-Jangalpur.Po: Andul Mouri, Howrah 711302, P:033 2669 0833/1151.1571, F: +9103326693856. F2+9103326693856. F2:NH2, Durgapur Expressway,</div>
            <div>PO: Gurap, Hoogly 712303, P:03213 253996</div>
            <div>CIN: U51109 WB1995PLC070893</div>
            
            <div style="margin-top: 5px;">
                We are on: 
                <span style="color: #3b5998; font-weight:bold; font-size: 10px;">f</span> &nbsp;
                <span style="color: #C13584; font-weight:bold; font-size: 10px;">ig</span> &nbsp;
                <span style="color: #0077b5; font-weight:bold; font-size: 10px;">in</span> &nbsp;
                <span style="color: #FF0000; font-weight:bold; font-size: 10px;">yt</span>
            </div>
           
        </div>

        
      


        <apex:repeat value="{!lineItems}" var="row">
            
            <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'CRASH TESTED') || CONTAINS(UPPER(row['name']), 'CONVENTIONAL') || CONTAINS(UPPER(row['name']), 'RAILWAY') || CONTAINS(UPPER(row['name']), 'NON-SPACER')}">
                
                <div class="table-title">{!row['name']}</div>
                
                <table class="spec-table">
                    <thead>
                        <tr>
                            <th style="width: 33%;">THICKNESS NAME</th>
                            <th style="width: 33%;">BLACK THICKNESS</th>
                            <th style="width: 33%;">FINISHED THICKNESS</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                        <tr>
                            <td style="font-weight: bold;">BEAM</td>
                            
                            <td>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'NATRAX')}">
                                    <apex:outputText value="{!IF(CONTAINS(UPPER(row['name']), 'THRIE'), jsonData['tb_natrax_beam_thickness'], jsonData['wb_natrax_beam_thickness'])}"/>
                                </apex:outputPanel>
                                <apex:outputPanel layout="none" rendered="{!CONTAINS(UPPER(row['name']), 'ALKA')}">
