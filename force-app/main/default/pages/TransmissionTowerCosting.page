<apex:page standardController="Quote" extensions="CostingExportController" renderAs="pdf" showHeader="false" sidebar="false" applyBodyTag="false" >
    <head>
         <style>
            @page { size: A4 landscape; margin: 10mm; }
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
    
            body {
                font-family: Arial, Helvetica, sans-serif;
                font-size: 11px;
                color: #000000;
                background: #ffffff;
                padding: 20px 30px 30px 30px;
            }
    
            .header-wrapper {
                width: 100%;
                margin-bottom: 6px;
            }
    
            .header-top {
                display: table;
                width: 100%;
            }
    
            .header-center {
                display: table-cell;
                text-align: center;
                vertical-align: top;
                width: 70%;
            }
    
            .header-logo {
                display: table-cell;
                text-align: right;
                vertical-align: top;
                width: 30%;
            }
            .logo-box {
                border: 2px solid #2E4053;
                display: inline-block;
                padding: 6px 10px;
                text-align: center;
            }
    
            .logo-utkarsh {
                font-size: 22px;
                font-weight: bold;
                color: #1A3A5C;
                letter-spacing: 1px;
                font-style: italic;
            }
    
            .logo-tagline {
                font-size: 8px;
                color: #555555;
                margin-top: 2px;
            }
   
            .header-divider {
                border: none;
                border-top: 2px solid #DAA520;
                margin: 8px 0 4px 0;
                width: 100%;
            }
            .cost-table-wrapper {
                width: 100%;
                margin-bottom: 22px;
             	page-break-after: always; 
            }            
            .cost-table-wrapper:last-child {
                page-break-after: auto !important;
            }
    
            .cost-table {
                width: 100%;
                border-collapse: collapse;
                border: 1px solid #999999;
            }

            .cost-table .table-title-row td {
                background-color: #ffffff;
                text-align: center;
                font-size: 12px;
                font-weight: bold;
                color: #000000;
                padding: 10px 8px;
                border: 1px solid #999999;
            }

            .cost-table .table-header-row td {
                background-color: #A9A9A9;
                color: #000000;
                font-weight: bold;
                font-size: 11px;
                text-align: center;
                padding: 8px 10px;
                border: 1px solid #999999;
            }

            .cost-table .data-row td {
                background-color: #ffffff;
                color: #000000;
                font-size: 11px;
                text-align: center;
                padding: 7px 10px;
                border: 1px solid #999999;
            }
    
            .cost-table .data-row td.col-label {
                text-align: center;
            }
    
            .cost-table .data-row td.col-value {
                text-align: center;
            }
    
            /* Empty spacer row */
            .cost-table .spacer-row td {
                padding: 6px;
                border: 1px solid #999999;
                background-color: #ffffff;
            }
    
    </style>
    </head>
	<body>
    <div style="position: fixed; top: 0; left: 0; width: 100%; z-index: 999; font-family: Arial, Helvetica, sans-serif;">
        <table style="width:100%; border-collapse:collapse; align-items: center; vertical-align:center;">
            <tr>
                <td style="width:100%; vertical-align:center; text-align:right;">
                    <div style="font-size:26px; font-weight:bold; margin-bottom:2px;">
                        Utkarsh India Limited
                    </div>
                    <div style="font-size:12px; margin-bottom:4px;">
                        (Formally Utkarsh Tubes &amp; Pipes Limited)
                    </div>
                    <hr style="border-top:2px solid #8bc34a; margin:4px 0 6px 0; width:100%;"/>
                    <div style="font-size:12px; margin-bottom:2px;">
                        Corporate Office: Arrjavv Square, 95A Elliot Road, 4th Floor, Kolkata 700016, P- 033 2264 6666/2265 888
                    </div>
                    <div style="font-size:9px;">
                        E- <a href="mailto:info@utkarshindia.in">info@utkarshindia.in</a> &nbsp; W- www.utkarshindia.in
                    </div>
                </td>
                <td style="width:40%; vertical-align:top;">
                    <apex:image url="{!$Resource.UtkarshLogo}" width="300px" />
                </td>
            </tr>
        </table>
    </div>
        
        <div style="position: absolute; top: 170px; left: 300px; font-size:18px; font-weight:bold; text-align: center;">
            COST FACTOR - Transmission Tower &amp; Substation
        </div>   
        <apex:repeat value="{!priceTables}" var="pt">
            <div style="padding-top: 200px;">   
            	<div class="cost-table-wrapper" style="{!IF(pt.isLast,'page-break-after:auto;','page-break-after:always;')}">
                <table class="cost-table">
                    <!-- Title Row -->
                    <tr class="table-title-row">
                        <td colspan="2">{!pt.title}</td>
                    </tr>
                    <!-- Header Row -->
                    <tr class="table-header-row">
                        <td style="width:65%;">Product Details</td>
                        <td style="width:35%;">Rate / ton</td>
                    </tr>
                    <!-- Data Rows -->
                    <apex:repeat value="{!pt.rows}" var="row">
                        <!-- Spacer row -->
                            <apex:outputPanel layout="none" rendered="{!row.isSpacer}">
                                <tr class="spacer-row">
                                    <td></td>
                                    <td></td>
                                </tr>
                            </apex:outputPanel>
    
                            <!-- Data row -->
                            <apex:outputPanel layout="none" rendered="{!!row.isSpacer}">
                                <tr class="data-row">
                                    <td class="col-label"><apex:outputText value="{!row.label}"></apex:outputText></td>
                                    <td class="col-value">
                                        <apex:outputText value="{!row.value}"></apex:outputText>
                                        <apex:outputText value="%" rendered="{!row.label == 'Margin'}"/>
                                    </td>
                                </tr>
                            </apex:outputPanel>
                    </apex:repeat>
                    
                    <p Style="font-weight:bold; font-size:11px; margin:12px 0;">
                        {!pt.footerNote}
                    </p>
                </table>
            </div>
            </div>
        </apex:repeat> 
  
    <div style="position: fixed; bottom: 20px; right: 30px; width: 100%; color: #000000; line-height: 1.4; ">
    
        <div style="text-align: right; font-weight: bold; margin-bottom: 2px;">Works:</div>
    
        <div style="text-align: right; font-size: 9px; margin-bottom: 2px;">
            F1: Nh6. Vill-Jangalpur.Po: Andul Mouri, Howrah 711302, P:033 2669 0833/1151.1571, F: +9103326693856. F2+9103326693856. F2:NH2, Durgapur Expressway,<br/>
            PO: Gurap, Hoogly 712303, P:03213 253996
        </div>
    
        <div style="text-align: right; font-size: 9px; margin-bottom: 2px;">
            CIN: US1109 WB1995PLC070893
        </div>
    
        <div style="text-align: right; font-size: 9px; margin-bottom: 2px;">
            We are on:
            <span style="display:inline-block; margin:0 2px;"><apex:image url="{!$Resource.facebookLogo}" width="30px" /></span>
            <span style="display:inline-block; margin:0 2px;"><apex:image url="{!$Resource.instagramLogo}" width="30px" /></span>
            <span style="display:inline-block; margin:0 2px;"><apex:image url="{!$Resource.facebookLogo}" width="30px" /></span>
            <span style="display:inline-block; margin:0 2px;"><apex:image url="{!$Resource.instagramLogo}" width="30px" /></span>
        </div>
    
        <div style="text-align: right; font-size: 9px; color: #555555;">
            Powered by: <span style="color:#1155CC; font-weight:bold;">DealDox.io</span>
        </div>
    </div>
</body>
</apex:page>